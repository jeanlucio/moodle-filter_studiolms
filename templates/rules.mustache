{{!
    @template filter_studiolms/rules

    Rules of a quiz drawn in place of the [QUIZINFO] marker.

    Only div and span with classes, so it survives the HTML cleaner.

    Example context (json):
    {
        "title": "Quiz rules",
        "cards": [
            {"label": "Questions", "value": "10"},
            {"label": "Attempts", "value": "Unlimited"},
            {"label": "Time", "value": "1 hour"},
            {"label": "Grade to pass", "value": "6 of 10"},
            {"label": "Closes", "value": "30/10/26, 18:00"}
        ]
    }
}}
<div class="slw-quiz">
    <div class="slw-quiz-title">{{title}}</div>
    <div class="slw-quiz-cards">
        {{#cards}}
        <div class="slw-quiz-card"><span class="slw-quiz-value">{{value}}</span><span class="slw-quiz-label">{{label}}</span></div>
        {{/cards}}
    </div>
</div>
