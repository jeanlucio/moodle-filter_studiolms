{{!
    @template filter_studiolms/map

    Course map drawn in place of the [COURSEMAP] marker.

    Only div, span and a with classes, so it survives the HTML cleaner.

    Example context (json):
    {
        "title": "Course map",
        "layout": "steps",
        "rows": [
            {"steps": [
                {"number": 1, "name": "Welcome", "url": "https://example.com/course/view.php?id=2#section-1", "state": "done", "statetext": "Done", "isdone": true},
                {"number": 2, "name": "Foundations", "url": "https://example.com/course/view.php?id=2#section-2", "state": "current", "statetext": "Current step", "isdone": false},
                {"number": 3, "name": "Practice", "url": "https://example.com/course/view.php?id=2#section-3", "state": "todo", "statetext": "", "isdone": false}
            ]}
        ]
    }
}}
<div class="slw-map slw-map-{{layout}}">
    <div class="slw-map-title">{{title}}</div>
    {{#rows}}
    <div class="slw-map-row">
        {{#steps}}
        <div class="slw-map-step slw-map-{{state}}">
            <span class="slw-map-number">{{#isdone}}&#10003;{{/isdone}}{{^isdone}}{{number}}{{/isdone}}</span>
            {{#url}}<a class="slw-map-name" href="{{url}}">{{name}}</a>{{/url}}{{^url}}<span class="slw-map-name">{{name}}</span>{{/url}}
            {{#statetext}}<span class="slw-map-state">{{statetext}}</span>{{/statetext}}
        </div>
        {{/steps}}
    </div>
    {{/rows}}
</div>
