{{!
    @template filter_studiolms/bar

    Participation bar drawn in place of the [FORUMSTATS] marker.

    Only div, span, ul and li with classes, and a percentage width, so it survives the HTML cleaner.

    Example context (json):
    {
        "title": "Participation in this forum",
        "segments": [
            {"key": "done", "label": "Participated", "percent": 70, "width": "70.00", "hasbar": true, "counttext": "7 of 10"},
            {"key": "todo", "label": "Not yet participated", "percent": 30, "width": "30.00", "hasbar": true, "counttext": "3 of 10"}
        ],
        "notice": ""
    }
}}
<div class="slw-bar">
    <div class="slw-bar-title">{{title}}</div>
    <div class="slw-bar-track">{{#segments}}{{#hasbar}}<div class="slw-bar-segment slw-bar-{{key}}" style="width: {{width}}%"></div>{{/hasbar}}{{/segments}}</div>
    <ul class="slw-bar-legend">
        {{#segments}}
        <li class="slw-bar-item"><span class="slw-bar-dot slw-bar-{{key}}"></span><span class="slw-bar-label">{{label}}</span> <span class="slw-bar-value">{{percent}}%{{#counttext}} ({{counttext}}){{/counttext}}</span></li>
        {{/segments}}
    </ul>
    {{#notice}}
    <div class="slw-bar-notice">{{notice}}</div>
    {{/notice}}
</div>
