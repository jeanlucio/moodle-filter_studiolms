{{!
    @template filter_studiolms/form_help

    Help line shown below the description editor of a forum form.

    Example context (json):
    {
        "text": "Write [FORUMSTATS] in the description to show how much of the class has taken part in this forum.",
        "warning": "The StudioLMS widgets filter is not active in this course."
    }
}}
<div class="slw-form-help">
    <div>{{text}}</div>
    {{#warning}}
    <div class="slw-form-warning"><i class="icon fa fa-triangle-exclamation" aria-hidden="true"></i> {{warning}}</div>
    {{/warning}}
</div>
